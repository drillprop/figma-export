{
  "manifest_version": 3,
  "name": "Design Compare",
  "version": "0.1.0",
  "description": "Overlay a Figma export on the live page to compare design and implementation: onion skin, swipe, difference.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle design overlay"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      }
    }
  }
}
